<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Applied after each .vcxproj so the compiler uses the shared settings even if the wizard wrote C++20. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>$(CPPStudyLanguageStandard)</LanguageStandard>
      <ConformanceMode>$(CPPStudyConformanceMode)</ConformanceMode>
      <BuildStlModules>$(CPPStudyBuildStlModules)</BuildStlModules>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    Property pages show the value stored in the .vcxproj, not Directory.Build.targets.
    The Console App wizard writes stdcpp20. On first load, replace that with C++23 for
    pure wizard projects (every LanguageStandard is C++20; mixed older projects are left alone).
  -->
  <Target Name="CPPStudyPatchWizardDefaults" Condition="'$(CPPStudyRewriteProjectFile)' != 'false' and '$(MSBuildProjectExtension)' == '.vcxproj'">
    <PropertyGroup>
      <_CPPStudyProjectText>$([System.IO.File]::ReadAllText('$(MSBuildProjectFullPath)'))</_CPPStudyProjectText>
      <_CPPStudyHasWizardCpp20>$(_CPPStudyProjectText.Contains('&lt;LanguageStandard&gt;stdcpp20&lt;/LanguageStandard&gt;'))</_CPPStudyHasWizardCpp20>
      <_CPPStudyHasCpp23>$(_CPPStudyProjectText.Contains('&lt;LanguageStandard&gt;stdcpp23&lt;/LanguageStandard&gt;'))</_CPPStudyHasCpp23>
      <_CPPStudyHasCppLatest>$(_CPPStudyProjectText.Contains('&lt;LanguageStandard&gt;stdcpplatest&lt;/LanguageStandard&gt;'))</_CPPStudyHasCppLatest>
      <_CPPStudyShouldPatch>false</_CPPStudyShouldPatch>
      <_CPPStudyShouldPatch Condition="$(_CPPStudyHasWizardCpp20) and !$(_CPPStudyHasCpp23) and !$(_CPPStudyHasCppLatest)">true</_CPPStudyShouldPatch>
    </PropertyGroup>
    <XmlPoke Condition="'$(_CPPStudyShouldPatch)' == 'true'"
             XmlInputPath="$(MSBuildProjectFullPath)"
             Query="/n:Project/n:ItemDefinitionGroup/n:ClCompile/n:LanguageStandard"
             Value="$(CPPStudyLanguageStandard)"
             Namespaces="&lt;Namespace Prefix='n' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;" />
  </Target>
</Project>
