<?xml version="1.0" encoding="utf-8"?>
<Project InitialTargets="CPPStudyPatchWizardDefaults">
  <!-- Defaults for every .vcxproj under this folder. Override in a project with e.g. <CPPStudyLanguageStandard>stdcpp20</CPPStudyLanguageStandard>. -->
  <PropertyGroup>
    <CPPStudyLanguageStandard Condition="'$(CPPStudyLanguageStandard)' == ''">stdcpp23</CPPStudyLanguageStandard>
    <CPPStudyConformanceMode Condition="'$(CPPStudyConformanceMode)' == ''">true</CPPStudyConformanceMode>
    <CPPStudyBuildStlModules Condition="'$(CPPStudyBuildStlModules)' == ''">true</CPPStudyBuildStlModules>
  </PropertyGroup>
  <!-- Inherited values for property pages when the .vcxproj does not set a local LanguageStandard / BuildStlModules. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>$(CPPStudyLanguageStandard)</LanguageStandard>
      <ConformanceMode>$(CPPStudyConformanceMode)</ConformanceMode>
      <BuildStlModules>$(CPPStudyBuildStlModules)</BuildStlModules>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
